{
  "name": "@fargone/rite",
  "version": "0.1.0",
  "type": "module",
  "description": "rite — a React component library distributed as a single package (@fargone/rite).",
  "homepage": "https://rite.platform.fargone.sh",
  "repository": {
    "url": "https://github.com/fargonesh/rite"
  },
  "keywords": ["react", "react-components", "component-library", "typescript", "tailwind", "charts", "schedule", "forms", "ui"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/rite/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/rite/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "build:app": "npm run sitemap && tsc -b && vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
